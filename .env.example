# Runtime environment (development | production | test)
NODE_ENV=development

# HTTP server port
PORT=3000

# Comma-separated allowlist of origins, or * for any origin
CORS_ORIGIN=*

# MongoDB connection string (local: mongodb://127.0.0.1:27017/<db> | Atlas: mongodb+srv://<user>:<pass>@<cluster>/<db>)
MONGODB_URI=mongodb+srv://saidlergili_db_user:5o2eaRg9HqlyWT7z@cluster0.fhc2wwo.mongodb.net/?appName=Cluster0

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long access tokens stay valid (jsonwebtoken format: 15m, 1h, 7d)
JWT_EXPIRES_IN=15m

# How long password reset tokens stay valid (minutes)
PASSWORD_RESET_TOKEN_TTL_MINUTES=15